"""Local configuration template for the public code release.

Copy this file to `config.py`, fill in your local paths, and keep it
untracked. The repository publishes code and execution entrypoints, not
machine-specific experiment settings.
"""

from __future__ import annotations

import torch

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

SEED = 66  # independent runs: 66, 67, 68, 69, 70
DEVICE = torch.device("cpu")
DTYPE = torch.float32

# ---------------------------------------------------------------------------
# Task selection
# ---------------------------------------------------------------------------

