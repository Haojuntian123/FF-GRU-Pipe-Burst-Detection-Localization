DATA_SPLIT = False
# Assign source periods and parent burst events to separate sets before
# windowing; train.py does not partition already-flattened window files.

# Flow files are interval readings generated by the hydraulic simulation.
# "sum" aggregates the readings across one event window.
# "volume" integrates rates (volume/second) over each interval and window.
FLOW_REDUCE = "sum"
