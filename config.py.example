MODEL_NAME = "GRU"  # GRU, CNN, GCN, FA-DenseNet, FF-GRU, FF-CNN, FF-GCN, FF-FA-DenseNet
MODEL_TYPE = MODEL_NAME
RUN_TAG = f"{TASK}_{MODEL_NAME.replace('-', '_')}_seed{SEED}"

# ---------------------------------------------------------------------------
# Core paths
# ---------------------------------------------------------------------------

